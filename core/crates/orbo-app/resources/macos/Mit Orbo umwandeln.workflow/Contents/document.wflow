				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Shell-Skript ausführen</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>url="orbo://open?"
sep=""
for f in "$@"; do
  enc=$(LC_ALL=C printf '%s' "$f" | od -An -v -tx1 | tr -d ' \n' | sed 's/../%&amp;/g')
  url="${url}${sep}f=${enc}"
  sep="&amp;"
done
[ -n "$sep" ] &amp;&amp; /usr/bin/open "$url"
</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
					<key>source</key>
