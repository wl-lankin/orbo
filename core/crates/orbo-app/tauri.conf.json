{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbo",
  "version": "1.1.3",
  "identifier": "de.wolfganglinz.orbo",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "orbo"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxMkFBNEJBREY3REVBOUIKUldTYjZuM2Z1cVFxTWZVUEkxa0tuVStlTVZMZ3JBNThodGtYbE03ZHJlWlR6WDZOSy9USG94RmkK",
      "endpoints": [
        "https://github.com/wl-lankin/orbo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "externalBin": [
      "bin/ffmpeg",
      "bin/ffprobe",
      "bin/orbo-cli"
    ],
    "resources": {
      "resources/windows/FFmpeg-LICENSE.txt": "FFmpeg-LICENSE.txt"
    },
    "publisher": "Wolfgang Linz",
    "copyright": "© 2026 Wolfgang Linz",
    "shortDescription": "Dateien umwandeln, ohne sie loszulassen",
    "homepage": "https://wolfgang-linz.de/orbo/"
  },
  "mainBinaryName": "Orbo"
}
